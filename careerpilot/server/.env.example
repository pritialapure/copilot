PORT=5000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5174
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
UPSTASH_REDIS_URL=
SEED_SAMPLE_DATA=false
NODE_ENV=development

# Shared secret for the automation-facing webhook at POST /api/ingest/internships.
# Generate any long random string, e.g.: openssl rand -hex 32
# Put the same value in your n8n/Zapier/Make workflow's HTTP request header:
#   x-ingest-key: <this value>
INGEST_API_KEY=
